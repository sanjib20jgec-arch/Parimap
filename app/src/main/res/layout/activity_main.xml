<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A2E">

    <!-- App Logo / Title Area -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📐 AR Measure"
        android:textSize="36sp"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:layout_marginTop="80dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Subtitle -->
    <TextView
        android:id="@+id/tvSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Camera দিয়ে যেকোনো কিছু Measure করো"
        android:textSize="16sp"
        android:textColor="#AAAAAA"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/tvTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Features List -->
    <TextView
        android:id="@+id/tvFeatures"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="✅ Real-time Edge Detection\n✅ Accurate AR Measurement\n✅ Length &amp; Breadth\n✅ Measurement History\n✅ cm / inch switch"
        android:textSize="16sp"
        android:textColor="#CCCCCC"
        android:lineSpacingExtra="8dp"
        android:layout_marginTop="40dp"
        android:layout_marginHorizontal="40dp"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Start Measuring Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnStartMeasure"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:text="🎯 Start Measuring"
        android:textSize="18sp"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:backgroundTint="#E94560"
        android:layout_marginHorizontal="40dp"
        android:layout_marginBottom="20dp"
        app:cornerRadius="12dp"
        app:layout_constraintBottom_toTopOf="@id/btnHistory"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- History Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnHistory"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:text="📋 Measurement History"
        android:textSize="16sp"
        android:textAllCaps="false"
        android:textColor="#AAAAAA"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_marginHorizontal="40dp"
        android:layout_marginBottom="60dp"
        app:cornerRadius="12dp"
        app:strokeColor="#444444"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
