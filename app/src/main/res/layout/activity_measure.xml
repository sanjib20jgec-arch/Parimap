<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- AR Scene View — camera + AR rendering -->
    <io.github.sceneview.ar.ArSceneView
        android:id="@+id/arSceneView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Edge Detection Overlay (transparent layer on top of camera) -->
    <ImageView
        android:id="@+id/edgeOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:visibility="gone"
        android:alpha="0.6"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Top Bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:background="#80000000"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Back Button -->
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:tint="#FFFFFF" />

        <!-- Plane Detection Status -->
        <TextView
            android:id="@+id/tvPlaneStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🔍 Surface খুঁজছে..."
            android:textSize="14sp"
            android:textColor="#FFD700"
            android:gravity="center"
            android:layout_marginHorizontal="8dp" />

        <!-- Unit Toggle -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUnitToggle"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="cm"
            android:textSize="14sp"
            android:textAllCaps="false"
            android:backgroundTint="#333333"
            android:minWidth="60dp"
            app:cornerRadius="18dp" />

    </LinearLayout>

    <!-- Measurement Display (centered, large) -->
    <TextView
        android:id="@+id/tvMeasurement"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ready"
        android:textSize="20sp"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:background="@drawable/measurement_bg"
        android:paddingHorizontal="24dp"
        android:paddingVertical="12dp"
        android:elevation="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Instruction Text (bottom area) -->
    <TextView
        android:id="@+id/tvInstruction"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Surface detect করতে phone টা আস্তে আস্তে ঘোরাও"
        android:textSize="14sp"
        android:textColor="#FFFFFF"
        android:textAlignment="center"
        android:background="#99000000"
        android:padding="12dp"
        android:layout_marginBottom="80dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Bottom Controls -->
    <LinearLayout
        android:id="@+id/bottomControls"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#CC000000"
        android:paddingHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Edge Toggle Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEdgeToggle"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="Edge: OFF"
            android:textSize="13sp"
            android:textAllCaps="false"
            android:backgroundTint="#666666"
            android:layout_marginEnd="8dp"
            app:cornerRadius="22dp" />

        <!-- Reset Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReset"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="🔄 Reset"
            android:textSize="13sp"
            android:textAllCaps="false"
            android:backgroundTint="#E94560"
            app:cornerRadius="22dp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
